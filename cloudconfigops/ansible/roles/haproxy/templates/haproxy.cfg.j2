global
    daemon

defaults
    mode http
    timeout connect 5s
    timeout client 50s
    timeout server 50s

frontend http_front
    bind *:80
    default_backend app_backend

backend app_backend
    balance roundrobin

{% for host in groups['app'] %}

    server {{ host }} {{ hostvars[host]['ansible_host'] }}:80 check

{% endfor %}
